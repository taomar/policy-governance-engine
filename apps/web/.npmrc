# Packages come from the approved Microsoft proxy, never the public registry.
#
# npm reads the .npmrc in the directory it is run from, and every build command
# here runs from apps/web — so the copy at the repository root does not apply
# and this file is the one npm actually reads. Kept byte-identical in intent to
# the root copy; test_packages_come_from_the_approved_feed.py fails if the two
# ever name different registries.
registry=https://packagefeedproxy.microsoft.io/npm/
