# The address of the policy API this playground calls.
VITE_POLICY_API_BASE_URL=http://localhost:8010

# Optional, and deliberately blank here.
#
# Set this in an untracked `.env.local` to have the demo start with the
# subscription key your operator generated for local use, instead of retyping a
# forty-character credential on every reload.
#
# It must stay empty in this committed file, and a real value must never be
# committed to any file. Vite inlines every `VITE_`-prefixed variable into the
# built bundle, so a key here is a key in `dist/` and a key served to every
# visitor. That is also why this is a local-demonstration convenience and not a
# way to configure a client: a browser is not a place a shared credential can be
# kept. See `docs/external-consumption.md`.
VITE_POLICY_SUBSCRIPTION_KEY=
