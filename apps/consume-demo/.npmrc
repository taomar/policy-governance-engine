# Packages come from the approved Microsoft proxy, never the public registry.
#
# npm reads the .npmrc in the directory it is run from, and every build command
# for this app runs from apps/consume-demo — so the copies at the repository root
# and in apps/web do not apply and this file is the one npm actually reads. It
# names a registry and nothing else: no credential, no auth token, no scoped
# override belongs in a committed file.
registry=https://packagefeedproxy.microsoft.io/npm/
