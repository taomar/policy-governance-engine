  "rules": [
    {
      "policy_set_id": "hardware-provisioning-policy",
      "policy_version_id": "vX",
      "rule_id": "RULE-HW-001",
      "rule_revision": 1,
      "title": "Self-service approval tier (<=150)",
      "description": "Requests at or below $150 require no approval and are fulfilled as self-service (Table 7.1).",
      "rule_type": "approval_requirement",
      "authority": {
        "level": "corporate",
        "owner": "digital-workplace",
        "rank": 10
      },
      "scope": {
        "jurisdictions": [
          "*"
        ],
        "organizational_units": [
          "*"
        ],
        "personas": [
          "*"
        ],
        "processes": [
          "hardware_provisioning"
        ]
      },
      "condition": {
        "type": "factComparison",
        "fact": "request_value_usd",
        "operator": "lessThanOrEqual",
        "value": 150
      },
      "effect": {
        "type": "allow",
        "action": "auto_approve"
      },
      "required_facts": [
        {
          "name": "request_value_usd",
          "data_type": "number",
          "required": true
        }
      ],
      "exceptions": [],
      "priority": 0,
      "effective_from": "2026-04-01"
    },
