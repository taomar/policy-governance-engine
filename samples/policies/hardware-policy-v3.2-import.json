    {
      "policy_set_id": "hardware-provisioning-policy",
      "policy_version_id": "vX",
      "rule_id": "RULE-HW-006",
      "rule_revision": 1,
      "title": "Third device refused",
      "description": "A request for a third computing device held at one time is refused unless raised as an exception (2.2).",
      "rule_type": "prohibition",
      "authority": {
        "level": "corporate",
        "owner": "digital-workplace",
        "rank": 10
      },
      "scope": {
        "jurisdictions": [
          "*"
        ],
        "organizational_units": [
          "*"
        ],
        "personas": [
          "*"
        ],
        "processes": [
          "hardware_provisioning"
        ]
      },
      "condition": {
        "type": "factComparison",
        "fact": "devices_held_count",
        "operator": "greaterThanOrEqual",
        "value": 3
      },
      "effect": {
        "type": "deny",
        "action": "refuse_request"
      },
      "required_facts": [
        {
          "name": "devices_held_count",
          "data_type": "number",
          "required": true
        }
      ],
      "exceptions": [],
      "priority": 0,
      "effective_from": "2026-04-01"
    },
    {
      "policy_set_id": "hardware-provisioning-policy",
      "policy_version_id": "vX",
      "rule_id": "RULE-HW-007",
      "rule_revision": 1,
      "title": "Contractor permanent-allocation entitlement",
      "description": "Contractors engaged for 20 working days or fewer are not entitled to a permanent allocation and are served from loan stock only (1.1).",
      "rule_type": "eligibility",
      "authority": {
        "level": "corporate",
        "owner": "digital-workplace",
        "rank": 10
      },
      "scope": {
        "jurisdictions": [
          "*"
        ],
        "organizational_units": [
          "*"
        ],
        "personas": [
          "*"
        ],
        "processes": [
          "hardware_provisioning"
        ]
      },
      "condition": {
        "type": "all",
        "all": [
          {
            "type": "factComparison",
            "fact": "is_contractor",
            "operator": "equals",
            "value": true
          },
          {
            "type": "factComparison",
            "fact": "engagement_days",
            "operator": "lessThanOrEqual",
            "value": 20
          }
        ]
      },
      "effect": {
        "type": "deny",
        "action": "deny_permanent_allocation_use_loan_stock"
      },
      "required_facts": [
        {
          "name": "is_contractor",
          "data_type": "boolean",
          "required": true
        },
        {
          "name": "engagement_days",
          "data_type": "number",
          "required": true
        }
      ],
      "exceptions": [],
      "priority": 0,
      "effective_from": "2026-04-01"
    },
    {
      "policy_set_id": "hardware-provisioning-policy",
      "policy_version_id": "vX",
      "rule_id": "RULE-HW-008",
      "rule_revision": 1,
      "title": "Self-approval prohibited",
      "description": "No colleague may approve their own request or a request from a person to whom they report; approval passes to the next level (7.3).",
      "rule_type": "prohibition",
      "authority": {
        "level": "corporate",
        "owner": "digital-workplace",
        "rank": 10
      },
      "scope": {
        "jurisdictions": [
          "*"
        ],
        "organizational_units": [
          "*"
        ],
        "personas": [
          "*"
        ],
        "processes": [
          "hardware_provisioning"
        ]
      },
      "condition": {
        "type": "any",
        "any": [
          {
            "type": "factComparison",
            "fact": "approver_is_requester",
            "operator": "equals",
            "value": true
          },
          {
            "type": "factComparison",
            "fact": "approver_reports_to_requester",
            "operator": "equals",
            "value": true
          }
        ]
      },
      "effect": {
        "type": "deny",
        "action": "escalate_to_next_management_level"
      },
      "required_facts": [
        {
          "name": "approver_is_requester",
          "data_type": "boolean",
          "required": true
        },
        {
          "name": "approver_reports_to_requester",
          "data_type": "boolean",
          "required": true
        }
      ],
      "exceptions": [],
      "priority": 0,
      "effective_from": "2026-04-01"
    },
