# Held only while scripts/mutation_check.py is running, to stop two runs
# mutating one checkout at the same time. Runtime state, and a committed one
# would block every run until someone deleted it.
.mutation-check.lock

# Uploaded document store. Runtime state, not source: these files are only
# meaningful alongside the Postgres rows that reference them, and the database
# is not in version control either. Sample documents that *are* source live in
# samples/source-documents/.
data/documents/

# Local agent/session records. Keep these on the workstation; do not publish.
AGENT_PROGRESS.md
Instructions for Claude Opus 5_*.md
docs/SESSION_HANDOFF.md
docs/adr/
docs/handoff/
docs/security-rbac-azure-readiness-plan.md
.impeccable/

# Azure Developer CLI local environments may contain secrets.
.azure/*
!.azure/deployment-plan.md

# Coverage output from test-quality audits.
.coverage
htmlcov/

# Authoring skills: local methodology, not part of the published product.
skills/

# Browser-tool scratch output.
.playwright-mcp/

# Environment variable files hold real values -- endpoints, logins, keys -- and
# stay on the workstation. Only the `*.example` templates are published, and they
# carry placeholders rather than anything from a live resource. `.env` alone did
# not cover `.env.local`, `.env.production` or `infra/parameters/baseline.env`,
# which is the file the published template is a template *for*.
.env
.env.*
*.env
!.env.example
!*.env.example

# Working notes. Decision records and task lists are reasoning aids for whoever
# is doing the work, not documentation of the product, so they are kept beside
# the code and out of the published repository. `docs/adr/` is listed above with
# the other local session records.
docs/todo/
docs/todos/
TODO.md
TODOS.md
todo.md
todos.md

# Session working records. The handover is written for whoever picks the work up
# on this machine -- session history, verbatim instructions, failure analyses --
# and is not documentation of the product. Matched by shape rather than by exact
# path: `docs/HANDOVER.md` alone left `HANDOVER.md`, `docs/handover/`,
# `docs/HANDOVER-2.md` and a lowercase spelling publishable, which is the same
# way a single `.env` rule left every other env file exposed.
#
# Deliberately narrow enough to keep the product's own handoff code published:
# `docs/specs/docling-integration-handoff.md`, `infrastructure/docling/handoff.py`
# and its test are source, not session notes.
HANDOVER*
handover*
docs/handover/
docs/HANDOVER.md
