# Local runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Access control. Off by default so an existing deployment is unchanged by an
# upgrade; enforcement is only as good as the identity behind it, so configure
# sign-in before switching it on.
RBAC_ENABLED=false

# Username/password sign-in for local testing, before an identity provider is
# connected. Reads `.local-accounts.txt`, which holds plain-text credentials
# and is gitignored. The API refuses to start with this enabled while
# ENVIRONMENT is production -- a plain-text credential file that can be turned
# on in production is worse than no authentication, because it looks like
# authentication.
LOCAL_ACCOUNTS_ENABLED=false

# Microsoft Entra (or any OIDC issuer). All three are needed before a bearer
# token can be validated; with any unset the token path is not offered at all
# rather than half-checked, because a partly verified token is worse than an
# unverified one -- it looks verified.
# ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# ENTRA_AUDIENCE=api://<client-id>
# ENTRA_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys

# Whether `X-MS-CLIENT-PRINCIPAL` may be believed. Off by default, and the
# default is the security decision: a proxy forwards headers it was not told to
# drop, so a caller can send that header themselves. Enable only where the
# ingress provably strips inbound copies.
TRUST_PLATFORM_AUTH_HEADER=false

# One pre-shared key for a non-interactive caller -- an agent, a workflow, a
# scheduled job -- sent in the `X-Policy-Subscription-Key` header. Blank means
# the mechanism does not exist: the header is not read at all, which is the same
# posture the token path takes with no issuer configured.
#
# Leave the value blank here and set it in your own gitignored `.env`. Generate
# something long and random; there is no strength requirement enforced, and a
# guessable key is a public API.
#
# ONE KEY, IN THIS INCREMENT. Every caller presenting it resolves to the single
# identity below, so it groups callers rather than distinguishing them. Rotation
# is: change the value and restart the API. There is no overlap window, no
# revocation list and no expiry. Prefer an OIDC issuer for anything that needs
# per-caller attribution or revocation without a restart.
POLICY_SUBSCRIPTION_KEY=
# The identity recorded on every audited receipt that key produces. Name the
# system, not a person.
POLICY_SUBSCRIPTION_KEY_IDENTITY=external-api-client
# The role that identity holds: viewer, policy_author or admin. Defaults to
# viewer, and lower is better -- this is a bearer credential with no expiry, so
# the blast radius of one that leaks should be a read rather than a publication.
POLICY_SUBSCRIPTION_KEY_ROLE=viewer

# PostgreSQL (non-default port to avoid local collisions)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=policy_platform
POSTGRES_USER=policy_admin
POSTGRES_PASSWORD=policy_admin_pw

# SQLAlchemy async connection URL (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://policy_admin:policy_admin_pw@localhost:5433/policy_platform

# Alembic (sync driver, psycopg) connection URL
ALEMBIC_DATABASE_URL=postgresql+psycopg://policy_admin:policy_admin_pw@localhost:5433/policy_platform

# API (non-default port; 8000 was already in use by another local process)
API_HOST=0.0.0.0
API_PORT=8010
DEV_AUTH_ENABLED=true

# Frontend. WEB_DEV_SERVER_PORT is the port Vite binds to *and* is automatically
# allowed through CORS, so changing it here is enough to move the UI.
WEB_DEV_SERVER_PORT=5490
VITE_API_BASE_URL=http://localhost:8010

# CORS. Leave CORS_ALLOWED_ORIGINS empty to derive the allowlist from
# WEB_DEV_SERVER_PORT plus CORS_DEV_PORT_RANGE (Vite increments its port when
# the preferred one is taken, so a single port is not enough locally).
# Set it explicitly for a deployed environment: an explicit list wins outright
# and the development range is then not added.
# `*` allows every browser origin. Use it only for a local demonstration; a
# production API carrying subscription-key requests should name its web origins.
CORS_ALLOWED_ORIGINS=
CORS_DEV_PORT_RANGE=5173-5180

# Azure OpenAI + Azure AI Search (required for the full product; blank is degraded local diagnostics only)
# Foundry project for this workspace: foundryfordevtarek
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_FAST_DEPLOYMENT=
AZURE_OPENAI_LUNA_DEPLOYMENT=
AZURE_OPENAI_TERRA_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_MODEL=
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_API_VERSION=2025-09-01

# Docling Graph dense extraction (optional 'graph' extra).
# Routed through LiteLLM at the Azure OpenAI deployment above, so there is one
# model configuration for the platform rather than a second parallel one.
DOCLING_GRAPH_ENABLED=false
DOCLING_GRAPH_MODEL=azure/gpt-4o
