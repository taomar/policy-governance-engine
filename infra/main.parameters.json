{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "resourceGroupName": { "value": "${AZURE_RESOURCE_GROUP}" },
    "resourceNamePrefix": { "value": "${AZURE_RESOURCE_PREFIX}" },
    "postgresAdministratorPassword": { "value": "${POSTGRES_ADMIN_PASSWORD}" },
    "postgresAdministratorLogin": { "value": "${POSTGRES_ADMIN_LOGIN}" },
    "postgresDatabaseName": { "value": "${POSTGRES_DATABASE_NAME}" },
    "postgresSkuName": { "value": "${POSTGRES_SKU_NAME}" },
    "postgresTier": { "value": "${POSTGRES_TIER}" },
    "postgresStorageSizeGb": { "value": "${POSTGRES_STORAGE_GB}" },
    "postgresBackupRetentionDays": { "value": "${POSTGRES_BACKUP_RETENTION_DAYS}" },
    "postgresZoneRedundantHa": { "value": "${POSTGRES_ZONE_REDUNDANT_HA}" },
    "searchSkuName": { "value": "${AZURE_SEARCH_SKU}" },
    "searchReplicaCount": { "value": "${AZURE_SEARCH_REPLICAS}" },
    "searchPartitionCount": { "value": "${AZURE_SEARCH_PARTITIONS}" },
    "searchAuthoringIndexName": { "value": "${AZURE_SEARCH_AUTHORING_INDEX}" },
    "searchEvidenceIndexName": { "value": "${AZURE_SEARCH_EVIDENCE_INDEX}" },
    "containerRegistrySku": { "value": "${AZURE_CONTAINER_REGISTRY_SKU}" },
    "storageSkuName": { "value": "${AZURE_STORAGE_SKU}" },
    "documentShareQuotaGb": { "value": "${AZURE_DOCUMENT_SHARE_QUOTA_GB}" },
    "logRetentionDays": { "value": "${AZURE_LOG_RETENTION_DAYS}" },
    "vnetAddressPrefix": { "value": "${AZURE_VNET_ADDRESS_PREFIX}" },
    "containerAppsSubnetPrefix": { "value": "${AZURE_CONTAINER_APPS_SUBNET_PREFIX}" },
    "postgresSubnetPrefix": { "value": "${AZURE_POSTGRES_SUBNET_PREFIX}" },
    "privateEndpointsSubnetPrefix": { "value": "${AZURE_PRIVATE_ENDPOINTS_SUBNET_PREFIX}" },
    "allowedIngressCidrs": { "value": "${AZURE_ALLOWED_INGRESS_CIDRS}" },
    "enableEntraAuthentication": { "value": "${AZURE_ENABLE_ENTRA_AUTH}" },
    "entraTenantId": { "value": "${AZURE_ENTRA_TENANT_ID}" },
    "entraClientId": { "value": "${AZURE_ENTRA_CLIENT_ID}" },
    "entraClientSecret": { "value": "${AZURE_ENTRA_CLIENT_SECRET}" },
    "openAiReasoningDeploymentName": { "value": "${AZURE_OPENAI_DEPLOYMENT}" },
    "openAiReasoningModelName": { "value": "${AZURE_OPENAI_REASONING_MODEL}" },
    "openAiReasoningModelVersion": { "value": "${AZURE_OPENAI_REASONING_MODEL_VERSION}" },
    "openAiReasoningDeploymentSku": { "value": "${AZURE_OPENAI_REASONING_SKU}" },
    "openAiReasoningCapacity": { "value": "${AZURE_OPENAI_REASONING_CAPACITY}" },
    "openAiSecondaryDeploymentName": { "value": "${AZURE_OPENAI_SECONDARY_DEPLOYMENT}" },
    "openAiSecondaryModelName": { "value": "${AZURE_OPENAI_SECONDARY_MODEL}" },
    "openAiSecondaryModelVersion": { "value": "${AZURE_OPENAI_SECONDARY_MODEL_VERSION}" },
    "openAiSecondaryDeploymentSku": { "value": "${AZURE_OPENAI_SECONDARY_SKU}" },
    "openAiSecondaryCapacity": { "value": "${AZURE_OPENAI_SECONDARY_CAPACITY}" },
    "openAiEmbeddingDeploymentName": { "value": "${AZURE_OPENAI_EMBEDDING_DEPLOYMENT}" },
    "openAiEmbeddingModelName": { "value": "${AZURE_OPENAI_EMBEDDING_MODEL}" },
    "openAiEmbeddingModelVersion": { "value": "${AZURE_OPENAI_EMBEDDING_MODEL_VERSION}" },
    "openAiEmbeddingDeploymentSku": { "value": "${AZURE_OPENAI_EMBEDDING_SKU}" },
    "openAiEmbeddingCapacity": { "value": "${AZURE_OPENAI_EMBEDDING_CAPACITY}" },
    "openAiEmbeddingDimensions": { "value": "${AZURE_OPENAI_EMBEDDING_DIMENSIONS}" },
    "openAiApiVersion": { "value": "${AZURE_OPENAI_API_VERSION}" },
    "searchApiVersion": { "value": "${AZURE_SEARCH_API_VERSION}" },
    "webMinReplicas": { "value": "${AZURE_WEB_MIN_REPLICAS}" },
    "webMaxReplicas": { "value": "${AZURE_WEB_MAX_REPLICAS}" },
    "apiMinReplicas": { "value": "${AZURE_API_MIN_REPLICAS}" },
    "apiMaxReplicas": { "value": "${AZURE_API_MAX_REPLICAS}" }
  }
}
